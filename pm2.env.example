# Copy to .env.local on the server (or set PM2_ENV_FILE to another path).
# Same variables as app/config.py (pydantic-settings). Do not commit real secrets.

# --- Database (same Postgres as DMRC_HRMS_API) ---
# Option A: full URL (passwords with @ must work; config normalizes @ in password)
# CHATBOT_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: discrete fields
POSTGRES_HOST=localhost
POSTGRES_LOCAL_PORT=5432
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=postgres

# --- Redis ---
# If Redis uses requirepass, either set password here or embed in REDIS_URL:
#   REDIS_URL=redis://:YOUR_PASSWORD@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=

# --- HRMS API ---
HRMS_BASE_URL=http://localhost:3001/api
HRMS_TIMEOUT=15

# --- JWT (GET /v1/chat/history uses HS256 + JWT_SECRET; falls back to SECRET_KEY if empty) ---
# JWT_SECRET=

# --- LLM ---
# groq | vllm | deepinfra | sarvam
LLM_PROVIDER=groq
GROQ_API_KEY=

# Sarvam AI chat completions — https://docs.sarvam.ai/api-reference-docs/api-guides-tutorials/chat-completion/overview
# LLM_PROVIDER=sarvam
# SARVAM_API_KEY=            # or SARVAM_SUBSCRIPTION_KEY (Bearer token)
# SARVAM_MODEL=sarvam-30b  # or sarvam-105b
# SARVAM_BASE_URL=https://api.sarvam.ai/v1
# Context window budgeting (tokens, rough estimate — see SARVAM_CONTEXT_WINDOW_TOKENS_* in config)
# CONVERSATION_SESSION_TOKEN_BUDGET=28000
# CONVERSATION_PROMPT_HISTORY_TOKEN_BUDGET=5200
# CONVERSATION_INTENT_HISTORY_TOKEN_BUDGET=1200
# LLM_CHAT_RATE_LIMIT_MAX_RETRIES=5
# LLM_CHAT_RATE_LIMIT_BASE_DELAY_SEC=1.0
# LLM_PROVIDER=deepinfra
# DEEPINFRA_TOKEN=           # or DEEPINFRA_API_KEY
# DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3
# DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# Optional: faster model for final response polish only (same provider token). If unset, uses main model.
# Invalid ids fall back to the main chat model. For Sarvam, use another Sarvam model id or leave unset.
# LLM_REVIEW_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# Optional: set false to skip reviewer LLM pass and reduce latency.
# ENABLE_RESPONSE_REVIEW=true
# Policy document RAG rollout controls
# POLICY_RAG_ENABLED=true
# POLICY_RAG_TOP_K=5
# POLICY_RAG_DOC_CONFIDENCE_THRESHOLD=0.26
# POLICY_RAG_FAQ_CONFIDENCE_THRESHOLD=0.25

# --- JWT / SSO ---
SSO_PUBLIC_KEY=
SECRET_KEY=

# --- App ---
DEBUG=false

# Optional: listen port (ecosystem.config.js reads PORT for uvicorn --port)
# PORT=8001
